# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# HMAC secret for leave/timesheet one-click email tokens
# Must match LEAVE_TOKEN_SECRET set in Supabase Edge Function secrets
VITE_HMAC_SECRET=your-secret-here

# Web Push (VAPID)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# HubSpot token is NOT needed here — it lives in Supabase Edge Function secrets as HUBSPOT_TOKEN
